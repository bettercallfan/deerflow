# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key
# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000

# Optional:
# LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=deer-flow
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local per-thread JSONL run event logs
# DEERFLOW_RUN_EVENT_LOG_ENABLED=1
# DEERFLOW_RUN_EVENT_LOG_DIR=./logs/run_events

# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-compatible-api-key
# ANTHROPIC_BASE_URL=http://your-anthropic-compatible-gateway/
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ============================================================================
# SkillRouter Embedding & Reranker Services
# ============================================================================
SKILLROUTER_EMBEDDING_BASE_KEY=unused
SKILLROUTER_EMBEDDING_BASE_URL=http://192.168.200.1:7800/v1

SKILLROUTER_RERANKER_BASE_KEY=unused
SKILLROUTER_RERANKER_BASE_URL=http://192.168.200.1:7801/v1

# ============================================================================
# Elasticsearch
# ============================================================================
ES_URL=http://172.17.0.1:3128
ES_USERNAME=citybrain-street
ES_PASSWORD=123456

# RAG 索引，保留给 RAG 模块使用
ES_INDEX=network-traffic-rag-smoke-clean

# SkillRouter 专用索引，新增
SKILL_ROUTER_ES_INDEX=citybrain-skill-router-cards

# Data Center 索引展示控制：逗号分隔的额外隐藏索引。
# multi-data-process-rag-chunks 为内部 RAG 分块索引，代码始终隐藏它。
DATA_CENTER_ES_INDEX_DENYLIST=multi-data-process-rag-chunks
# 可选：仅展示指定索引；拒绝列表优先于允许列表。
# DATA_CENTER_ES_INDEX_ALLOWLIST=

# Multi Data Process -> DeerFlow RAG
# The Gateway only reads the fixed source index and materialises its own chunks index.
MULTI_DATA_PROCESS_RAG_SOURCE_INDEX=multi-data-process-documents
MULTI_DATA_PROCESS_RAG_CHUNKS_INDEX=multi-data-process-rag-chunks
# Generate different long random values. Sync token is shared only with the MDP callback;
# search token is injected only into the DeerFlow sandbox and is never put in a Skill file.
MULTI_DATA_PROCESS_RAG_SYNC_TOKEN=replace-with-a-long-random-sync-token
MULTI_DATA_PROCESS_RAG_SEARCH_TOKEN=replace-with-a-long-random-search-token
# Docker sandbox reaches the host-published Gateway through the host gateway address.
MULTI_DATA_PROCESS_RAG_GATEWAY_URL=http://172.17.0.1:3318
